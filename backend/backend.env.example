# Application Configuration
APP_NAME=Shopee AI Ops
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api/v1
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

# Database - use SQLite for development, PostgreSQL for production
SQLITE_PATH=dev.db
# POSTGRES_DSN=postgresql://user:password@localhost:5432/shopee_ai_ops

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# Frontend API base URL
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

# Security - IMPORTANT: Change these in production!
SESSION_SECRET_KEY=change-me-in-production
PLATFORM_AUTH_STATE_SECRET=change-me-in-production
# Security - IMPORTANT: Change these in production!
SESSION_SECRET_KEY=change-me-in-production
PLATFORM_AUTH_STATE_SECRET=change-me-in-production
# TOKEN_ENCRYPTION_KEY must be a 64-character hex string (32 bytes). Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
TOKEN_ENCRYPTION_KEY=
API_KEY=your-api-key-here
API_KEY=your-api-key-here

# CORS
CORS_ORIGINS=http://localhost:3000

# Shopee OAuth 2.0
SHOPEE_CLIENT_ID=your_shopee_partner_id
SHOPEE_CLIENT_SECRET=your_shopee_partner_secret
SHOPEE_AUTH_URL=https://partner.shopeemobile.com/api/v2/oauth/authorize
SHOPEE_REDIRECT_URI=http://localhost:8000/api/v1/platform-connections/shopee/callback
SHOPEE_API_BASE=https://partner.shopeemobile.com/api/v1

# 1688 OAuth
ALIBABA_CLIENT_ID=your_1688_app_key
ALIBABA_CLIENT_SECRET=your_1688_app_secret
ALIBABA_AUTH_URL=https://gw.open.1688.com/openapi/param2/1/system.oauthCode
ALIBABA_REDIRECT_URI=http://localhost:8000/api/v1/platform-connections/1688/callback
ALIBABA_API_BASE=https://gw.open.1688.com/openapi
ALIBABA_COOKIE=

# Authorization Flags (auto-managed)
SHOPEE_AUTHORIZED=false
ALIBABA_AUTHORIZED=false
